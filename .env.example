# Puerto HTTP del servidor
PORT=3000

# URL pública del servidor, con https (sin barra final). Se usa para el login y los enlaces.
BASE_URL=https://tu-dominio.com

# App Dashboard de Meta > Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=

# Cadena que inventas y pegas también en Meta (Webhooks > Verify token)
VERIFY_TOKEN=pon-aqui-una-cadena-secreta

# Mínimo 32 caracteres aleatorios. Cifra los tokens guardados. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Base de datos SQLite
DATABASE_PATH=data/app.db

GRAPH_API_VERSION=v23.0

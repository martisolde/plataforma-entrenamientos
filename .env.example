# Puerto HTTP del servidor
PORT=3000

# Token que tú inventas y pegas también en el panel de Meta (Webhooks > Verify token)
VERIFY_TOKEN=pon-aqui-una-cadena-secreta

# App Dashboard > Instagram > API setup with Instagram login > "Instagram app secret"
APP_SECRET=

# Token de acceso de larga duración de tu cuenta de Instagram (empieza por IG...)
IG_ACCESS_TOKEN=

# Versión de la Graph API
GRAPH_API_VERSION=v23.0

# Fichero con las reglas palabra clave -> DM (copia rules.example.json a rules.json)
RULES_FILE=rules.json

# Dónde guardar los IDs de comentarios ya respondidos (evita DMs duplicados)
DATA_DIR=data

# true = solo registra lo que haría, no envía nada (para probar)
DRY_RUN=false
